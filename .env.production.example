# Production environment for the Hetzner VPS.
#
#   cp .env.production.example .env      (on the server, next to docker-compose.prod.yml)
#
# NEVER commit the filled-in version. Every value below belongs in the
# customer's password manager as well as on the server — if the box is lost,
# these are what you need to rebuild.

# --- Database ---------------------------------------------------------------
# Two roles, deliberately.
#
# POSTGRES_USER owns the database and runs migrations. It is a SUPERUSER, and
# Postgres lets superusers bypass row-level security no matter what the policies
# say — so the application must NOT connect as this role, or the tenant
# isolation in ADR-0007 is decorative.
#
# APP_DB_USER is what the app connects as: login + data access, no DDL, no
# bypass. ops/harden-db-role.sh creates it and refuses to finish unless it can
# prove the role sees zero rows without a tenant set.
#
# Generate each password with:  openssl rand -base64 32
POSTGRES_USER="canei"
POSTGRES_PASSWORD="CHANGE_ME_generate_a_long_random_string"
POSTGRES_DB="canei_erp"

APP_DB_USER="canei_app"
APP_DB_PASSWORD="CHANGE_ME_generate_a_different_long_random_string"

# --- Application ------------------------------------------------------------
# The public URL, i.e. what the Cloudflare tunnel hostname resolves to.
APP_URL="https://erp.example.com"

# Who is using this server. Every ERP change is stamped with this name in the
# audit trail, so it must be a real person, not "admin" or "system".
#
# SINGLE SEAT. Correct while there is no login and the server is reachable only
# over an SSH tunnel from one machine: there is exactly one operator and naming
# them here is honest. The API refuses to write anything at all if this is unset
# — an unattributable change to an invoice register is worse than a failed
# request.
ERP_OPERATOR="Nombre Apellido"

# PUBLISHED MODE. Set BOTH of these once the ERP is behind a login, and the
# signed-in email is stamped instead of ERP_OPERATOR — which is what makes more
# than one person attributable. Setting only one is refused at start-up rather
# than falling back to the shared name above, because a deployment that meant to
# require login and lost a variable would otherwise keep serving and credit
# everybody's work to one person.
#
#   CF_ACCESS_TEAM_DOMAIN  Zero Trust → Settings → Custom Pages → team domain,
#                          e.g. "canei.cloudflareaccess.com" (no https://).
#   CF_ACCESS_AUD          Zero Trust → Access → Applications → your app →
#                          Overview → Application Audience (AUD) Tag.
#
# The assertion is signature-verified against the team's published keys, so this
# holds even if the app is ever reachable without going through the proxy.
CF_ACCESS_TEAM_DOMAIN=""
CF_ACCESS_AUD=""

# LOGIN MODE (the pilot). This application's own accounts — no third party, no
# domain required. Set BOTH, or neither; one alone is refused at start-up.
#
#   ERP_USERS       comma-separated "email:hash" pairs, in SINGLE quotes — a
#                   hash contains "$16384", which inside double quotes the shell
#                   reads as a variable. Generate each with
#                     node apps/web/scripts/hash-password.mjs someone@example.com
#                   The password itself is never stored.
#   SESSION_SECRET  a long random string used to sign session cookies. Generate:
#                     head -c 48 /dev/urandom | base64
#                   Changing it signs everybody out immediately, everywhere,
#                   which is how you revoke access to a lost phone.
ERP_USERS=''
SESSION_SECRET=''

# SHARED ACCESS — one link and one password, no account needed.
#
# For giving an owner or operator evaluating the system a way in on their own
# laptop, tablet or phone. They sign in with this password and NO email address.
#
#   ERP_ACCESS_PASSWORD="a long phrase you can read out in a meeting"
#
# THIS REACHES THE LIVE DATA. A session opened this way can add, change and
# delete real records, exactly like a named account — the only difference is
# that the audit trail records it as "invitado-XXXX" rather than a person.
# So before a session: take a backup. After a session: change this password.
# Emptying it switches shared access off entirely.
ERP_ACCESS_PASSWORD=''

# Which company this deployment is for. The workspace asks the server for "~"
# rather than naming a company in a file served to everybody; this is what "~"
# resolves to.
ERP_DEFAULT_TENANT="diorka"

# --- Pilot ingress (HTTPS without owning a domain) --------------------------
# Used by the `pilot` compose profile. See ops/Caddyfile and
# docs/PILOT-WITHOUT-CLOUDFLARE.md.
#
# PUBLIC_HOSTNAME is your server's IPv4 with dots replaced by dashes, plus
# .sslip.io — for 203.0.113.7 that is "203-0-113-7.sslip.io". It resolves to the
# address with no registration, and Let's Encrypt will issue a real certificate
# for it. Swap in the company domain when it transfers; nothing else changes.
PUBLIC_HOSTNAME=""
# Where Let's Encrypt sends certificate-expiry warnings.
ACME_EMAIL=""

# Images published by .github/workflows/deploy.yml. `main` is the rolling tag;
# pin to a specific SHA tag to freeze a version (see HANDOVER-OPS.md → rollback).
IMAGE_APP="ghcr.io/OWNER/REPO/app:main"
IMAGE_MIGRATE="ghcr.io/OWNER/REPO/migrate:main"

# --- Cloudflare tunnel ------------------------------------------------------
# From the Cloudflare dashboard: Zero Trust → Networks → Tunnels → your tunnel
# → Install connector. Copy the token out of the shown command.
CLOUDFLARE_TUNNEL_TOKEN="CHANGE_ME"

# --- Backups to Cloudflare R2 ----------------------------------------------
# R2 → Manage API tokens → Create token, scoped to the backup bucket only.
R2_ACCOUNT_ID="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET="canei-erp-backups"

# Public half of the age key that backups are encrypted to. Generate with:
#   age-keygen -o age-key.txt      → the file's line starting "age1..." is this
# Keep the PRIVATE half out of this file and out of the server: it lives in the
# customer's password manager. A backup you can decrypt from the same box you
# are backing up is not protection against that box being compromised.
BACKUP_AGE_RECIPIENT="age1CHANGE_ME"

# How many days of backups to keep in R2.
BACKUP_RETENTION_DAYS="30"
