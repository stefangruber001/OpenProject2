{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "BUILD_REVISION",
    "CF_ACCESS_AUD",
    "CF_ACCESS_TEAM_DOMAIN",
    "CI",
    "DATABASE_URL",
    "E2E_DATABASE_URL",
    "ERP_ACCESS_PASSWORD",
    "ERP_DEFAULT_TENANT",
    "ERP_OPERATOR",
    "ERP_USERS",
    "NEXT_PUBLIC_APP_URL",
    "NODE_ENV",
    "PUBLIC_HOSTNAME",
    "RLS_TEST_DATABASE_URL",
    "SESSION_SECRET",
    "SMTP_FROM",
    "SMTP_URL",
    "TENANTS_DIR",
    "UI_LANG"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
