# Values are read from fastlane/.env.default (copy it from .env.example, fill
# once). See ios/README.md and the 2-page beta guide.

# Treat empty env (unset CI secret ⇒ "") as absent, not as an override.
def _or(v, d); v.to_s.strip.empty? ? d : v; end

app_identifier(_or(ENV["APP_BUNDLE_ID"], "com.caneisubirats.erp"))
apple_id(_or(ENV["APPLE_ID"], nil))        # optional; API key auth doesn't need it
team_id(_or(ENV["DEVELOPER_TEAM_ID"], "5V62K942X6")) # Apple Developer team id
