# Canei Subirats — release credentials (fill once).
#
# Copy this file to  fastlane/.env.default  and set ONE value: the path to your
# .p8 key. The Key ID (TD9Q544H27), Issuer ID, Team ID and bundle id are already
# baked into the project — this is all that's left, because the .p8 is the only
# real secret and must stay off the repo.
#
# .env.default is gitignored — your key path/contents never land in the repo.

# Path to the AuthKey_TD9Q544H27.p8 you downloaded from App Store Connect
# (Users and Access → Integrations → App Store Connect API → Download).
# Keep it OUTSIDE the repo, e.g. in ~/.appstoreconnect/.
ASC_KEY_P8_PATH=/Users/you/.appstoreconnect/AuthKey_TD9Q544H27.p8
# …or paste the key contents inline instead (leave PATH blank if you use this):
# ASC_KEY_P8=

# Everything else is pre-filled; uncomment only to override:
# ASC_KEY_ID=TD9Q544H27
# ASC_ISSUER_ID=10347fb1-a3c7-4894-a183-18d98a79a8d0
# DEVELOPER_TEAM_ID=5V62K942X6
# APP_BUNDLE_ID=com.caneisubirats.erp
