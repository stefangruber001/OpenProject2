# Canei Subirats — fastlane automation.
#
# The `beta` lane builds a signed archive and uploads it to TestFlight.
#
# Auth uses an App Store Connect API key (recommended — no 2FA prompts).
# Provide these as environment variables (locally or as CI secrets):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8   (the .p8 contents, or a path)
#   DEVELOPER_TEAM_ID                        (Apple Developer team id)
#
# Local first run:  cd ios && bundle exec fastlane beta
# (or without bundler:  fastlane beta)

default_platform(:ios)

SCHEME = "CaneiSubirats"
PROJECT = "CaneiSubirats.xcodeproj"

platform :ios do
  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    setup_ci if is_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8"],   # raw .p8 contents; or use key_filepath:
      is_key_content_base64: false,
      in_house: false
    )

    # Auto-increment build number to the next TestFlight build.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "com.caneisubirats.erp",
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: (latest + 1).to_s
    )

    # Managed signing via App Store Connect API (no manual certs needed).
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: ENV["DEVELOPER_TEAM_ID"]
      },
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Latest Canei Subirats build. Web content updates automatically."
    )

    puts "✓ Uploaded to TestFlight. Add testers in App Store Connect › TestFlight."
  end

  desc "Just build a signed .ipa locally (no upload)"
  lane :build_only do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )
  end
end
