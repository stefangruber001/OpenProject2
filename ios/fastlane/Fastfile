# Canei Subirats — fastlane automation.
#
# The `beta` lane builds a signed archive and uploads it to TestFlight.
#
# Auth uses an App Store Connect API key (recommended — no 2FA prompts).
# Values are read from fastlane/.env.default (copy it from .env.example and fill
# once); fastlane loads that file automatically. On CI they come from Secrets.
#   ASC_KEY_ID, ASC_ISSUER_ID, DEVELOPER_TEAM_ID, APP_BUNDLE_ID
#   ASC_KEY_P8_PATH (path to the .p8)  — or  ASC_KEY_P8 (the .p8 contents)
#
# Ship:  cd ios && make ship   (or: bundle exec fastlane beta)

require "shellwords"

default_platform(:ios)

SCHEME = "CaneiSubirats"
PROJECT = "CaneiSubirats.xcodeproj"

# Treat a missing OR EMPTY env var as absent. In CI, `FOO: ${{ secrets.FOO }}`
# sets FOO to "" when the secret isn't set — an empty string is truthy in Ruby,
# so a plain `||` would override the baked-in default with "" and break auth.
def env_or(name, default)
  v = ENV[name].to_s.strip
  v.empty? ? default : v
end

BUNDLE_ID = env_or("APP_BUNDLE_ID", "com.caneisubirats.erp")
TEAM_ID = env_or("DEVELOPER_TEAM_ID", "5V62K942X6")

# Non-secret App Store Connect API identifiers baked in for convenience — these
# alone cannot authenticate; the .p8 private key is the secret (ASC_KEY_P8_PATH
# locally, or the ASC_KEY_P8 base64 secret in CI). Override via env to rotate.
ASC_KEY_ID = env_or("ASC_KEY_ID", "TD9Q544H27")
ASC_ISSUER_ID = env_or("ASC_ISSUER_ID", "10347fb1-a3c7-4894-a183-18d98a79a8d0")

def asc_api_key
  path = ENV["ASC_KEY_P8_PATH"].to_s.strip
  if !path.empty?
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: File.expand_path(path),
      in_house: false
    )
  else
    # CI path: the ASC_KEY_P8 secret holds the BASE64 of the .p8 (robust against
    # newline mangling in secret stores — the raw PEM often fails with
    # "invalid curve name"). Create it with:  base64 -i AuthKey_XXXX.p8 | pbcopy
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true,
      in_house: false
    )
  end
end

# The code-signing identity match just installed, by its common name.
#
# `security find-identity -v -p codesigning` lists what the search list holds as
#   1) A1B2C3… "Apple Distribution: Stefan Gruber (5V62K942X6)"
# and xcodebuild's CODE_SIGN_IDENTITY matches on the quoted name. Distribution
# comes first because a runner can hold a development identity too and picking
# it is how a release build gets signed with the wrong key — an .ipa that
# uploads and then fails validation, which is the slowest way to find out.
def distribution_identity
  names = `security find-identity -v -p codesigning 2>/dev/null`.scan(/"([^"]+)"/).flatten
  names.find { |n| n.start_with?("Apple Distribution") } ||
    names.find { |n| n.start_with?("iPhone Distribution") } ||
    names.find { |n| n.include?("Distribution") }
end

platform :ios do
  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    setup_ci if is_ci

    api_key = asc_api_key

    # Auto-increment build number to the next TestFlight build.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: (latest + 1).to_s
    )

    # THE SIGNING IDENTITY IS FETCHED, NOT MINTED.
    #
    # This used to pass `-allowProvisioningUpdates` with the API key, which tells
    # xcodebuild to ASK APPLE FOR A NEW distribution certificate whenever it
    # cannot find one locally. A runner is a fresh machine every time, so it
    # never found one, so every single build created another — and Apple caps a
    # standard account at three. The account hit that cap twice; the second time
    # it stopped the build on the day the submission was being prepared, with
    # thirteen seconds of log and no other explanation.
    #
    # `match` downloads the ONE certificate and the ONE profile from the store
    # and installs them in the temporary keychain `setup_ci` made. `readonly` is
    # the whole point: a build can use what exists and can create nothing, so
    # this lane cannot put the account back at the cap however often it runs.
    match(
      type: "appstore",
      readonly: true,
      api_key: api_key,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    # Manual signing, because automatic signing is the thing that mints. The
    # profile name and the team come from match's own output, so there is no
    # second place to keep them in step.
    profile = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID]

    # AND THE IDENTITY, WHICH SWITCHING TO MANUAL DOES NOT CARRY OVER.
    #
    # The project is CODE_SIGN_STYLE = Automatic with no CODE_SIGN_IDENTITY of
    # its own, because under automatic signing Xcode picks one. Overriding the
    # style to Manual here turns that off — and leaves CODE_SIGN_IDENTITY at
    # Xcode's default, which is a DEVELOPMENT identity. The build then failed
    # looking for an "iOS Development" certificate that a release runner has no
    # reason to hold, while the distribution certificate match had just
    # installed sat unused in the keychain.
    #
    # READ FROM THE KEYCHAIN, NOT WRITTEN DOWN. The two distribution kinds have
    # different common names — "Apple Distribution: …" for the modern type,
    # "iPhone Distribution: …" for the older one this account's free slot gave
    # us — and xcodebuild matches on that name. Hardcoding either would be a
    # second source of truth that breaks silently the day the other kind is
    # stored, which is exactly the sort of thing that surfaces as a failed
    # release build months later. So: ask the keychain what match put there.
    identity = distribution_identity
    UI.user_error!(
      "No distribution identity in the keychain after match. The store on the " \
        "`certificates` branch is empty or holds the wrong kind — run the " \
        "'iOS · Signing setup' workflow."
    ) if identity.nil?
    UI.message("Signing with: #{identity}")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "CODE_SIGN_IDENTITY=#{identity.shellescape}",
        "PROVISIONING_PROFILE_SPECIFIER=#{profile.shellescape}"
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        signingCertificate: identity,
        provisioningProfiles: { BUNDLE_ID => profile }
      },
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Latest Canei Subirats build. Web content updates automatically."
    )

    puts "✓ Uploaded to TestFlight. Add testers in App Store Connect › TestFlight."
  end

  # ------------------------------------------------------------ certificates
  #
  # RUN ONCE. This is the lane that is allowed to create things.
  #
  # It asks Apple — through the App Store Connect API key, so no Mac and no
  # Keychain export is involved — for one distribution certificate and one App
  # Store provisioning profile, encrypts both with MATCH_PASSWORD and pushes
  # them to the `certificates` branch. Every build lane afterwards only reads.
  #
  # You run it again when the certificate expires (Apple gives three years), or
  # if the store is ever lost. Not otherwise: each run of THIS lane is a
  # certificate against the account's cap of three, which is the whole problem
  # it exists to end.
  # WHAT APPLE ACTUALLY HOLDS, BEFORE ANYTHING TRIES TO ADD TO IT.
  #
  # "Reached the maximum number of available Distribution certificates" is the
  # one error in this file that cannot be diagnosed from the log it prints. It
  # does not say how many there are, which kinds count, or which of them the
  # portal is still holding after somebody has revoked what they believed to be
  # the right rows — and the portal's own list is paginated and sorted in ways
  # that hide the answer. Three runs were spent on that guess.
  #
  # So this asks, and prints. It creates nothing and revokes nothing; it is safe
  # to run at any time, and it is run before the creating lane so that a failure
  # arrives with its evidence already on screen.
  #
  # The cap is per certificate TYPE, not per account, which is the detail that
  # makes the portal misleading: "Distribution" (Apple Distribution) and
  # "iOS Distribution" are different types with separate counters, and a
  # Xcode-managed row counts against one of them while looking like neither.
  desc "Read-only: list the signing certificates Apple holds for this account"
  lane :certificates_audit do
    require "spaceship"

    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(**asc_api_key)

    certs = Spaceship::ConnectAPI::Certificate.all
    rows = certs.map do |c|
      {
        type: c.certificate_type.to_s,
        # THE NAME IS NOT THE AUTHOR. This is the certificate's common name,
        # which Apple sets to the account holder for distribution certificates
        # whoever asked for them — so a row reading "STEFAN GRUBER" may well
        # have been minted by a CI runner. The portal's "Created By" column is a
        # different field and the API does not return it. Reading this column as
        # provenance is how four certificates got revoked for the wrong reason.
        name: c.display_name.to_s,
        expires: c.expiration_date.to_s[0, 10],
        id: c.id.to_s
      }
    end

    puts ""
    puts "#{rows.length} certificate(s) on the account:"
    puts ""
    rows.sort_by { |r| [r[:type], r[:expires]] }.each do |r|
      puts format("  %-22s  %-28s  expires %-12s  %s",
                  r[:type], r[:name][0, 28], r[:expires], r[:id])
    end

    puts ""
    puts "Per type:"
    rows.group_by { |r| r[:type] }.sort.each do |type, list|
      puts format("  %-22s  %d", type, list.length)
    end

    # The two that matter for an App Store upload. match's `generate_apple_certs`
    # default mints DISTRIBUTION; IOS_DISTRIBUTION is the legacy type that still
    # occupies its own slot. Either being full stops the creating lane.
    %w[DISTRIBUTION IOS_DISTRIBUTION].each do |type|
      n = rows.count { |r| r[:type] == type }
      puts "  → #{type} is at #{n} of 3#{n >= 3 ? "  ← FULL, this is what blocks creation" : ""}"
    end
    puts ""
  end

  desc "ONE-OFF: create the signing certificate and store it encrypted"
  lane :certificates do |options|
    setup_ci if is_ci
    UI.user_error!("MATCH_PASSWORD is not set — nothing can be encrypted") if
      ENV["MATCH_PASSWORD"].to_s.strip.empty?

    # WHICH OF THE TWO DISTRIBUTION BUCKETS TO SPEND.
    #
    # Apple caps each certificate TYPE at three, separately. "Apple
    # Distribution" (DISTRIBUTION) is the modern one and the one match mints by
    # default; "iOS Distribution" (IOS_DISTRIBUTION) is the older one, still
    # issued and still perfectly able to sign an App Store build.
    #
    # This account's DISTRIBUTION bucket is full and its IOS_DISTRIBUTION bucket
    # is not. The alternative to using the free bucket is revoking one of the
    # three that are full — and a revocation is irreversible, kills that
    # certificate everywhere at once including on whatever Mac is holding its
    # private key, and cannot be undone if it turns out to have been the wrong
    # one. Spending an empty slot destroys nothing. That is the whole argument.
    #
    # `legacy: true` picks the older type. Run certificates_audit first; it
    # prints which bucket has room.
    legacy = options[:legacy].to_s.strip.downcase == "true"

    match(
      type: "appstore",
      readonly: false,
      generate_apple_certs: !legacy,
      api_key: asc_api_key,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    kind = legacy ? "iOS Distribution" : "Apple Distribution"
    puts "✓ #{kind} certificate and profile stored. Every build from here reuses them."
  end

  # ---------------------------------------------------------------- release
  #
  # ONE CLICK, OR A CLEAR REASON WHY NOT.
  #
  # `deliver` uploads everything in fastlane/metadata — the listing text in both
  # languages, the URLs, the category, the screenshots and the App Review notes
  # — and then submits the build for review. Everything it needs is in this
  # repository EXCEPT three values only the operator has, which are checked
  # first and named individually:
  #
  #   · the contact phone App Review calls if something is wrong
  #   · a working demo account, because the app has no public sign-up and
  #     guideline 2.1 rejects an app a reviewer cannot get into
  #
  # A submission that fails on any of those costs a review cycle — days — so
  # this refuses to start rather than spend one. The password is never committed:
  # it comes from ASC_DEMO_PASSWORD and is written into the metadata only for the
  # length of the run.
  # ALL OF THESE ARE ABSOLUTE, AND THAT IS THE WHOLE POINT.
  #
  # fastlane runs a lane with the working directory changed to the `fastlane`
  # folder itself (runner.rb does the chdir). So the perfectly reasonable-looking
  # "fastlane/metadata/…" resolved to ios/fastlane/**fastlane**/metadata/… — a
  # path that has never existed. Everything downstream then failed OPEN rather
  # than loudly:
  #
  #   · `Dir.exist?("fastlane/screenshots")` was false, so `skip_screenshots`
  #     came out true and the listing went up without a single picture.
  #   · `refuse_if_unfilled!` globbed the missing directory, got an empty list,
  #     found nothing containing FILL-ME and returned happily. THE GATE AGAINST
  #     SUBMITTING A PLACEHOLDER PASSWORD HAS NEVER CHECKED ANYTHING.
  #   · `with_demo_password` never wrote the secret, because the write was
  #     guarded on the variable being set and it was not — so the bug stayed
  #     invisible until the day the secret was finally added, at which point the
  #     write ran for the first time and blew up on the missing directory.
  #
  # That last one is the only reason this was ever seen. Had the secret been
  # added a day earlier, the lane would have sailed through and sent Apple a
  # demo password of "FILL-ME" — a guideline 2.1 rejection, which is the exact
  # thing the gate exists to prevent.
  #
  # `__dir__` is this file's own directory. It does not move when fastlane
  # chdirs, so nothing below depends on where anyone ran anything from.
  META_DIR = File.expand_path("metadata", __dir__).freeze
  REVIEW_DIR = File.join(META_DIR, "review_information").freeze
  DEMO_PW_FILE = File.join(REVIEW_DIR, "demo_password.txt").freeze

  # ABSOLUTE, FROM THIS FILE. Not "fastlane/screenshots" relative to whatever
  # the working directory happens to be.
  #
  # The old relative form silently disabled the screenshot upload. `deliver`
  # printed `skip_screenshots | true` in its summary, uploaded the text, said
  # "Listing uploaded", passed precheck and exited 0 — and the listing sat in
  # App Store Connect with no pictures in it. Nothing failed. The screenshots
  # were committed, the gate said 121/121, and the only way to find out was to
  # open App Store Connect and look.
  #
  # `__dir__` is this Fastfile's own directory, so the path is the same whoever
  # runs it from wherever. Passing it to `screenshots_path` as well means
  # deliver reads the same folder this decided on, instead of re-deriving its
  # own and possibly disagreeing.
  SHOTS_DIR = File.expand_path("screenshots", __dir__).freeze

  # `deliver` reads the password out of a FILE, so the secret has to touch the
  # working copy. That file is tracked — it ships the FILL-ME placeholder — so
  # whatever is written here is put back afterwards no matter how the lane ends.
  # Without the restore, a local run leaves a real password sitting in a tracked
  # file, `git status` shows it as an ordinary modification, and the next
  # `git add -A` commits it. The mandate is that secrets never enter git; that
  # has to hold for the machine the operator is actually sitting at, not only
  # for the ephemeral CI checkout.
  def with_demo_password
    original = File.exist?(DEMO_PW_FILE) ? File.read(DEMO_PW_FILE) : nil
    pw = ENV["ASC_DEMO_PASSWORD"].to_s
    File.write(DEMO_PW_FILE, pw) unless pw.strip.empty?
    yield
  ensure
    File.write(DEMO_PW_FILE, original) unless original.nil?
  end

  # Did the caller actually ask to submit?
  #
  # Only `true` and the string "true" mean yes. Everything else — "false", an
  # empty string, nil, a typo — means no. Submitting is the irreversible half of
  # this lane (it puts a build in front of App Review and spends a cycle if it is
  # the wrong one), so an ambiguous value has to fall on the side that does
  # nothing. The DEFAULT when nobody says, deliberately, is still `true`: that is
  # what the workflow's own default is, and a lane called `release` that quietly
  # did not release would be its own trap.
  def submit_requested?(options)
    raw = options.fetch(:submit, true)
    return raw if raw == true || raw == false
    raw.to_s.strip.downcase == "true"
  end

  # Call inside with_demo_password, so the environment variable counts as filled.
  #
  # LOOKING AND FINDING NOTHING IS NOT THE SAME AS FINDING NOTHING WRONG. This
  # used to read an empty list from a directory that did not exist and conclude
  # that every field was filled. A check whose passing condition is "I saw no
  # files" passes hardest exactly when it is pointed at the wrong place, which
  # is the one situation it most needs to fail. So the files are counted first,
  # and an implausible count is itself the failure.
  EXPECTED_REVIEW_FIELDS = %w[
    demo_password demo_user email_address first_name last_name notes phone_number
  ].freeze

  def refuse_if_unfilled!
    found = Dir[File.join(REVIEW_DIR, "*.txt")]
    UI.user_error!(
      "No App Review fields found under #{REVIEW_DIR} — expected " \
        "#{EXPECTED_REVIEW_FIELDS.length} (#{EXPECTED_REVIEW_FIELDS.join(', ')}). " \
        "The directory is missing or the path is wrong; either way nothing was " \
        "checked, and an unchecked submission is the thing this refuses to make."
    ) if found.length < EXPECTED_REVIEW_FIELDS.length

    missing = found.select { |f| File.read(f).include?("FILL-ME") }
    return if missing.empty?
    names = missing.map { |f| File.basename(f, ".txt") }.sort.join(", ")
    UI.user_error!(
      "App Review needs these before a submission is worth making: #{names}. " \
        "Fill them in #{REVIEW_DIR}/ (the demo password can come from the " \
        "ASC_DEMO_PASSWORD environment variable instead of the file). " \
        "An app a reviewer cannot sign into is rejected under guideline 2.1, " \
        "and that costs a review cycle."
    )
  end

  desc "Upload the App Store listing and submit the latest build for review"
  lane :release do |options|
    with_demo_password do
      refuse_if_unfilled!

      shots = Dir[File.join(SHOTS_DIR, "*", "*.png")]
      UI.user_error!(
        "No screenshots under #{SHOTS_DIR} — Apple will not take a listing " \
          "without them. Run `node scripts/app-store-shots.mjs` and commit."
      ) if shots.empty?
      UI.message("Uploading #{shots.length} screenshots from #{SHOTS_DIR}")

      # THE VERSION AND THE BUILD, NAMED RATHER THAN INFERRED.
      #
      # Left to itself, deliver edited whatever version App Store Connect had
      # open — which was 1.0, while the project has been on 1.1 and TestFlight
      # holds 1.1 builds. So the listing went onto a version no build can ever
      # belong to: App Store Connect will not attach a 1.1 binary to a 1.0
      # version. That is why the app had no icon there. The icon is not
      # something a listing carries; it is read out of the attached build, and
      # there was no attached build.
      #
      # Both numbers now come from the places that already hold them — the
      # Xcode project for the version, TestFlight for the build — so there is
      # nothing to keep in step by hand.
      version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
      build = latest_testflight_build_number(
        api_key: asc_api_key,
        app_identifier: BUNDLE_ID,
        version: version,
        initial_build_number: 0
      )
      UI.user_error!(
        "TestFlight has no processed build for version #{version}. Run the " \
          "'iOS · TestFlight' workflow and wait for processing before submitting."
      ) if build.to_i.zero?
      UI.message("Listing version #{version}, build #{build}")

      upload_to_app_store(
        api_key: asc_api_key,
        app_identifier: BUNDLE_ID,
        app_version: version,
        build_number: build.to_s,
        # The build is whatever TestFlight already has — `beta` put it there and
        # it has been tested. Building a second, different binary here would
        # submit something nobody has run.
        skip_binary_upload: true,
        skip_screenshots: false,
        screenshots_path: SHOTS_DIR,
        overwrite_screenshots: true,
        # Ask before it goes, unless the caller has already decided.
        #
        # COERCED, NOT PASSED THROUGH. A lane option arriving from the command
        # line is a STRING — `fastlane release submit:false` gives the string
        # "false", and in Ruby every string is truthy, including that one. The
        # workflow interpolates a GitHub boolean straight into that argument, so
        # "do not submit" reached this line as a value that means "submit".
        #
        # fastlane's own configuration layer happens to convert "false" for a
        # Boolean option, which is the only reason this has not already sent a
        # build to review by accident. That is a library internal holding up a
        # decision about somebody's App Store account, so it is made explicit
        # here: anything that is not literally true — the boolean or the word —
        # means do not submit. The safe reading is the default.
        submit_for_review: submit_requested?(options),
        automatic_release: false,
        force: true, # no interactive HTML preview — this runs unattended
        precheck_include_in_app_purchases: false,
        submission_information: {
          # No IDFA, no ads, no tracking — the app is a shell around the
          # company's own workspace.
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
          content_rights_contains_third_party_content: false
        }
      )
      # SAY WHICH OF THE TWO THINGS HAPPENED. This line used to claim the build
      # had gone to review every time, including the runs whose whole purpose
      # was NOT to submit — so the log could not be used to tell the difference,
      # and the only way to know whether an app had been sent to Apple was to go
      # and look in App Store Connect. A message that is printed whatever
      # happened reports nothing.
      if submit_requested?(options)
        puts "✓ Listing uploaded and the TestFlight build SUBMITTED for review."
      else
        puts "✓ Listing uploaded. NOTHING was submitted — re-run with submit:true to send it."
      end
    end
  end

  desc "Upload the App Store listing only — no submission"
  lane :metadata do
    with_demo_password do
      refuse_if_unfilled!
      upload_to_app_store(
        api_key: asc_api_key,
        app_identifier: BUNDLE_ID,
        skip_binary_upload: true,
        skip_screenshots: true,
        submit_for_review: false,
        force: true
      )
    end
  end

  desc "Just build a signed .ipa locally (no upload)"
  lane :build_only do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )
  end
end
