# Canei Subirats — fastlane automation.
#
# The `beta` lane builds a signed archive and uploads it to TestFlight.
#
# Auth uses an App Store Connect API key (recommended — no 2FA prompts).
# Values are read from fastlane/.env.default (copy it from .env.example and fill
# once); fastlane loads that file automatically. On CI they come from Secrets.
#   ASC_KEY_ID, ASC_ISSUER_ID, DEVELOPER_TEAM_ID, APP_BUNDLE_ID
#   ASC_KEY_P8_PATH (path to the .p8)  — or  ASC_KEY_P8 (the .p8 contents)
#
# Ship:  cd ios && make ship   (or: bundle exec fastlane beta)

require "base64"
require "fileutils"
require "shellwords"
require "tmpdir"

default_platform(:ios)

SCHEME = "CaneiSubirats"
PROJECT = "CaneiSubirats.xcodeproj"

# Treat a missing OR EMPTY env var as absent. In CI, `FOO: ${{ secrets.FOO }}`
# sets FOO to "" when the secret isn't set — an empty string is truthy in Ruby,
# so a plain `||` would override the baked-in default with "" and break auth.
def env_or(name, default)
  v = ENV[name].to_s.strip
  v.empty? ? default : v
end

BUNDLE_ID = env_or("APP_BUNDLE_ID", "com.caneisubirats.erp")
TEAM_ID = env_or("DEVELOPER_TEAM_ID", "5V62K942X6")

# Non-secret App Store Connect API identifiers baked in for convenience — these
# alone cannot authenticate; the .p8 private key is the secret (ASC_KEY_P8_PATH
# locally, or the ASC_KEY_P8 base64 secret in CI). Override via env to rotate.
ASC_KEY_ID = env_or("ASC_KEY_ID", "TD9Q544H27")
ASC_ISSUER_ID = env_or("ASC_ISSUER_ID", "10347fb1-a3c7-4894-a183-18d98a79a8d0")

def asc_api_key
  path = ENV["ASC_KEY_P8_PATH"].to_s.strip
  if !path.empty?
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: File.expand_path(path),
      in_house: false
    )
  else
    # CI path: the ASC_KEY_P8 secret holds the BASE64 of the .p8 (robust against
    # newline mangling in secret stores — the raw PEM often fails with
    # "invalid curve name"). Create it with:  base64 -i AuthKey_XXXX.p8 | pbcopy
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_content: ENV["ASC_KEY_P8"],
      is_key_content_base64: true,
      in_house: false
    )
  end
end

# Absolute path to the .p8 (materialised from the local file or the CI base64
# secret) so xcodebuild's -allowProvisioningUpdates can authenticate with App
# Store Connect during the ARCHIVE and create the cloud distribution certificate
# + App Store provisioning profile. Absolute + /tmp: fastlane runs inside the
# fastlane/ dir, so a relative path would nest wrong.
def asc_key_path
  dest = File.join(Dir.tmpdir, "canei_asc_api_key.p8")
  path = ENV["ASC_KEY_P8_PATH"].to_s.strip
  if !path.empty?
    FileUtils.cp(File.expand_path(path), dest)
  else
    File.write(dest, Base64.decode64(ENV["ASC_KEY_P8"].to_s))
  end
  dest
end

platform :ios do
  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    setup_ci if is_ci

    api_key = asc_api_key

    # Auto-increment build number to the next TestFlight build.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      initial_build_number: 0
    )
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: (latest + 1).to_s
    )

    # Managed signing. Pass the API key auth to the ARCHIVE step only, via
    # -allowProvisioningUpdates: xcodebuild creates the cloud distribution
    # certificate + App Store profile and installs the profile locally. The
    # EXPORT step then reuses that installed profile with automatic signing —
    # NO auth flags on export (adding them made xcodebuild error 64).
    key_path = asc_key_path
    archive_auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyID #{ASC_KEY_ID}",
      "-authenticationKeyIssuerID #{ASC_ISSUER_ID}",
      "-authenticationKeyPath #{key_path.shellescape}"
    ].join(" ")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: archive_auth,
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: TEAM_ID
      },
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: "Latest Canei Subirats build. Web content updates automatically."
    )

    puts "✓ Uploaded to TestFlight. Add testers in App Store Connect › TestFlight."
  end

  desc "Just build a signed .ipa locally (no upload)"
  lane :build_only do
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "CaneiSubirats.ipa",
      clean: true
    )
  end
end
