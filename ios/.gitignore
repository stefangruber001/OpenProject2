# Xcode / build artifacts
build/
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive

# Xcode user state (keep the shared scheme, ignore per-user data)
xcuserdata/
*.xcuserstate
*.xcuserdatad

# fastlane
fastlane/report.xml
fastlane/Preview.html
# NOT the screenshots. They are part of the App Store listing exactly like
# description.txt is, and the `release` lane uploads whatever is in
# fastlane/screenshots from a CLEAN CI checkout. Ignored, they existed only on
# the machine that generated them and the one-click submission would have gone
# up with an empty gallery. Regenerate with `node scripts/app-store-shots.mjs`
# and commit the result.
fastlane/test_output
fastlane/*.mobileprovision

# Secrets — never commit these
*.p8
*.p12
*.cer
*.mobileprovision
.env
# fastlane dotenv: ignore the filled-in file, keep the template
fastlane/.env.default
fastlane/.env.local
!fastlane/.env.example
