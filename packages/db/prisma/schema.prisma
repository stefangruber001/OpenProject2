// Prisma schema — durable substrate for the factory's kernel store ports.
// Deliberately GENERIC: aggregates/artifacts are JSONB payloads keyed by
// (tenant_id, kind, id). Domain shape lives in capabilities; the database is
// infrastructure and stays jurisdiction/sector-free. Every table carries
// tenant_id and is protected by RLS (see the migration SQL — ADR-0007).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per tenant of the fleet.
model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

/// Mutable aggregates (Repository port): quotes, drafts, settings…
model Aggregate {
  tenantId  String   @map("tenant_id")
  kind      String
  id        String
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, kind, id])
  @@map("aggregates")
}

/// Immutable artifacts (AppendOnlyStore port): issued invoices…
model Artifact {
  tenantId  String   @map("tenant_id")
  kind      String
  id        String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@id([tenantId, kind, id])
  @@map("artifacts")
}

/// Atomic counters (CounterStore port): numbering series, event sequences.
model Counter {
  tenantId String @map("tenant_id")
  key      String
  value    Int

  @@id([tenantId, key])
  @@map("counters")
}

/// Small durable state (KeyValueStore port): chain heads…
model KvState {
  tenantId String @map("tenant_id")
  key      String
  value    Json

  @@id([tenantId, key])
  @@map("kv_state")
}

/// Whole-document state, versioned for optimistic concurrency.
///
/// Distinct from KvState on purpose. KvState is for small values whose last
/// writer is legitimately the winner (chain heads); this table holds a document
/// that two people can edit at once, so a blind upsert would silently discard
/// one of them. `version` makes a stale write fail loudly instead.
model ErpState {
  tenantId  String   @map("tenant_id")
  key       String
  version   Int      @default(0)
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @default("") @map("updated_by")

  @@id([tenantId, key])
  @@map("erp_state")
}

/// Append-only domain events (EventLogPort).
model Event {
  tenantId String @map("tenant_id")
  seq      Int
  type     String
  at       String
  payload  Json

  @@id([tenantId, seq])
  @@map("events")
}
