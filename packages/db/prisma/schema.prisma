// Prisma schema — durable substrate for the factory's kernel store ports.
// Deliberately GENERIC: aggregates/artifacts are JSONB payloads keyed by
// (tenant_id, kind, id). Domain shape lives in capabilities; the database is
// infrastructure and stays jurisdiction/sector-free. Every table carries
// tenant_id and is protected by RLS (see the migration SQL — ADR-0007).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per tenant of the fleet.
model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenants")
}

/// Mutable aggregates (Repository port): quotes, drafts, settings…
model Aggregate {
  tenantId  String   @map("tenant_id")
  kind      String
  id        String
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, kind, id])
  @@map("aggregates")
}

/// Immutable artifacts (AppendOnlyStore port): issued invoices…
model Artifact {
  tenantId  String   @map("tenant_id")
  kind      String
  id        String
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@id([tenantId, kind, id])
  @@map("artifacts")
}

/// Atomic counters (CounterStore port): numbering series, event sequences.
model Counter {
  tenantId String @map("tenant_id")
  key      String
  value    Int

  @@id([tenantId, key])
  @@map("counters")
}

/// Small durable state (KeyValueStore port): chain heads…
model KvState {
  tenantId String @map("tenant_id")
  key      String
  value    Json

  @@id([tenantId, key])
  @@map("kv_state")
}

/// Whole-document state, versioned for optimistic concurrency.
///
/// Distinct from KvState on purpose. KvState is for small values whose last
/// writer is legitimately the winner (chain heads); this table holds a document
/// that two people can edit at once, so a blind upsert would silently discard
/// one of them. `version` makes a stale write fail loudly instead.
model ErpState {
  tenantId  String   @map("tenant_id")
  key       String
  version   Int      @default(0)
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String   @default("") @map("updated_by")

  @@id([tenantId, key])
  @@map("erp_state")
}

/// Binary attachments — the site photographs taken on a visit.
///
/// A separate table rather than another field on the document, for the same
/// reason `erp_state` keeps bytes out of the payload: the document is
/// re-serialised on a debounce as somebody types, and megabytes of JPEG in that
/// blob would be re-encoded and re-sent on every keystroke. The symptom of
/// getting this wrong reads as "the ERP is slow", which points nowhere near the
/// photographs.
///
/// No `version` column. These are written once and read many times; a photo is
/// not edited concurrently, it is added or removed. Optimistic concurrency here
/// would be ceremony protecting nothing.
model ErpBlob {
  tenantId  String   @map("tenant_id")
  key       String
  mime      String   @default("application/octet-stream")
  bytes     Bytes
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String   @default("") @map("created_by")

  @@id([tenantId, key])
  @@map("erp_blob")
}

/// Append-only domain events (EventLogPort).
model Event {
  tenantId String @map("tenant_id")
  seq      Int
  type     String
  at       String
  payload  Json

  @@id([tenantId, seq])
  @@map("events")
}

/// People who may sign in, and what they may do.
///
/// Accounts used to be `ERP_USERS` in the server's `.env` — a file that also
/// holds the database password, so adding a colleague meant handing over the
/// keys. Here they are rows, which is what makes a screen possible.
///
/// `hash` is empty until the person activates: the admin creates the account,
/// the INVITED person chooses the password, and nobody else ever knows it.
///
/// `sessionsValidFrom` is how disabling somebody actually ends their sessions.
/// Session tokens are signed and stateless, so there is nothing to delete —
/// instead every token carries when it was issued, and a token older than this
/// stamp is refused. Moving it forward logs that person out everywhere without
/// touching anybody else, which rotating SESSION_SECRET could not do.
///
/// Deactivate, never delete: the audit trail has to keep resolving who did
/// what, and a row that vanishes turns every entry it authored into a mystery.
model ErpUser {
  tenantId          String   @map("tenant_id")
  /// Lower-cased. The identity the audit trail carries.
  email             String
  name              String   @default("")
  /// admin · backoffice · site · gestoria
  role              String   @default("backoffice")
  /// invited · active · disabled
  state             String   @default("invited")
  /// scrypt, with a per-user salt. Empty while the invitation is outstanding.
  hash              String   @default("")
  sessionsValidFrom DateTime @default(now()) @map("sessions_valid_from")
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @default("") @map("created_by")
  updatedAt         DateTime @updatedAt @map("updated_at")
  disabledAt        DateTime? @map("disabled_at")

  @@id([tenantId, email])
  @@map("erp_users")
}

/// Single-use, time-limited invitations and password resets.
///
/// The raw token is in the link and NEVER stored — only its SHA-256. A stolen
/// database therefore yields no usable link, which is the whole point of
/// hashing something that grants access.
model ErpUserToken {
  tenantId  String    @map("tenant_id")
  /// SHA-256 of the raw token, hex.
  tokenHash String    @map("token_hash")
  email     String
  /// activation · reset
  purpose   String    @default("activation")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @default("") @map("created_by")

  @@id([tenantId, tokenHash])
  @@map("erp_user_tokens")
}
