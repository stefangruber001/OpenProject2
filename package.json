{
  "name": "openproject2",
  "private": true,
  "description": "OpenProject2 monorepo root.",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:site": "node tests/site-e2e/run.mjs",
    "db:generate": "pnpm --filter @repo/db generate",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:deploy": "pnpm --filter @repo/db deploy",
    "db:push": "pnpm --filter @repo/db push",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:seed": "pnpm --filter @repo/db seed",
    "factory": "tsx packages/factory/src/cli.ts",
    "boundaries": "tsx packages/boundary-lint/src/cli.ts",
    "prepare": "husky",
    "test:sync": "node tests/site-sync/run.mjs",
    "test:i18n": "node tests/i18n/coverage.mjs",
    "test:i18n-audit": "node tests/i18n/audit.mjs",
    "test:workbook": "node tests/workbook/coverage.mjs",
    "test:ios-routes": "node tests/ios-routes/coverage.mjs",
    "test:pdf": "node tests/doc-pdf/run.mjs",
    "test:docs": "node tests/doc-print/run.mjs",
    "test:mailbox": "tsx tests/mailbox/run.mts"
  },
  "devDependencies": {
    "@tesseract.js-data/cat": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "pdfjs-dist": "6.2.108",
    "prettier": "^3.7.4",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "tsx": "^4.19.2",
    "turbo": "^2.10.5",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,json,css,yaml,yml}": "prettier --write"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
